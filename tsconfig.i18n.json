{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": "src/i18n",
    "outDir": ".i18n-test",
    "noEmit": false,
    "incremental": false,
    "plugins": []
  },
  "include": ["src/i18n/**/*.ts", "src/i18n/**/*.tsx"],
  "exclude": ["node_modules"]
}
